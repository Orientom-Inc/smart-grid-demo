# Copy to .env for local development.
QMEMS_CACHE_DIR=./cache
QMEMS_CORS_ORIGINS=["*"]
QMEMS_MAX_COUPLINGS=1500

# The one write path. Keep false for any public deployment.
QMEMS_ENABLE_LIVE_SOLVE=false
QMEMS_LIVE_SOLVE_METHODS=["qubo_sa","qubo_dp","milp","rule_based"]
QMEMS_MAX_CONCURRENT_JOBS=2

# Hard ceiling on QPU submissions per process. 0 disables hardware entirely.
QMEMS_DWAVE_SUBMISSION_BUDGET=0
# DWAVE_API_TOKEN=...   # only if you raise the budget above
